          <div class="row-amt">${fmtRp(t.amount)}</div>
        </div>`).join('') : '<div class="empty-state"><div class="ic">✅</div>Tidak ada transaksi mencurigakan.</div>'}
    </div>
    <div class="section-title">Selisih Tutup Kasir</div>
    <div class="card" style="padding:6px 14px;">
      ${closingsWithSelisih.length? closingsWithSelisih.map(c=>{
        const relKasbon = DB.kasbon.filter(k=>k.account_id===c.account_id && k.tanggal===c.tanggal);
        return `<div class="row-item">
          <div class="row-dot" style="background:var(--warning)"></div>
          <div class="row-main"><div class="row-title">${esc(getAccount(c.account_id)?.name||'-')} · ${c.tanggal}</div>
          <div class="row-sub">${relKasbon.length? relKasbon.length+' kasbon terkait hari itu — cek dulu sebelum simpulkan kecurangan':'Tidak ada kasbon terkait'}</div></div>
          <div class="row-amt" style="color:var(--warning)">${fmtRp(c.selisih)}</div>
        </div>`;
      }).join('') : '<div class="empty-state">Belum ada selisih tercatat.</div>'}
    </div>
  `;
}

