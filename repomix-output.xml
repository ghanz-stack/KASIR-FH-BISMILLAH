window._expenseType = 'COGS';
function flowColor(flow){ return flow==='Pemasukan'?'var(--success)': flow==='Pengeluaran'?'var(--danger)':'var(--muted)'; }
function flowBadge(flow){
  const cls = flow==='Pemasukan'?'badge-in':flow==='Pengeluaran'?'badge-out':'badge-netral';
  return `<span class="badge ${cls}">${flow}</span>`;
}
function selInputAccount(id){
  inputState.account_id=id;
  const cats = inputCategoriesFor(id);
  if(!cats.find(c=>c.id===inputState.category_id)) inputState.category_id = cats[0]?.id || null;
  rerenderInputPartial();
}
function selInputCategory(id){ inputState.category_id=id; rerenderInputPartial(); }
function selExpenseType(t){ window._expenseType=t;
  document.getElementById('et-cogs').classList.toggle('sel', t==='COGS');
  document.getElementById('et-cogs').style.background = t==='COGS' ? '#f59e0b' : '';
  document.getElementById('et-opex').classList.toggle('sel', t==='OPEX');
  document.getElementById('et-opex').style.background = t==='OPEX' ? '#f59e0b' : '';
}
function selPaymentStatus(s){ inputState.payment_status=s;
  document.getElementById('ps-paid').classList.toggle('sel', s==='paid');
  document.getElementById('ps-paid').style.background = s==='paid' ? 'var(--success)' : '';
  document.getElementById('ps-unpaid').classList.toggle('sel', s==='unpaid');
  document.getElementById('ps-unpaid').style.background = s==='unpaid' ? 'var(--warning)' : '';
  document.getElementById('pelanggan-wrap').style.display = s==='unpaid' ? '' : 'none';
}
function rerenderInputPartial(){
  const keep = kpValue;
  document.getElementById('screen').innerHTML = screenInput(false);
  kpValue = keep;
  const disp = document.getElementById('kp-display'); if(disp) disp.textContent = fmtRp(kpValue);
}
function scrollToMe(el){ setTimeout(()=>el.scrollIntoView({behavior:'smooth', block:'center'}), 150); }

function submitTransaksi(){
  if(!inputState.account_id) return toast('Pilih akun dulu','error');
  if(!inputState.category_id) return toast('Pilih kategori dulu','error');
  const amount = Number(kpValue);
  if(!amount || amount<=0) return toast('Nominal harus diisi','error');
  const acc = getAccount(inputState.account_id);
  const cat = getCategory(inputState.category_id);
  const jenis = document.getElementById('f-jenis').value.trim() || cat.name;
  const catatan = document.getElementById('f-catatan').value.trim();
  const profit = cat.flow==='Pemasukan' ? Number(document.getElementById('f-profit').value||0) : 0;
  const paymentStatus = inputState.payment_status;
  let pelanggan = '';
  if(paymentStatus==='unpaid'){
    pelanggan = document.getElementById('f-pelanggan').value.trim();
    if(!pelanggan) return toast('Isi nama pelanggan untuk transaksi kasbon','error');
    if(cat.flow!=='Pemasukan') return toast('Kasbon hanya berlaku untuk transaksi Pemasukan','error');
  }
  // ---- mode EDIT: perbarui transaksi yang sudah ada, bukan buat baru ----
  if(editingTxId){
    const orig = DB.transactions.find(x=>x.id===editingTxId);
    if(!orig || orig.locked){
      toast('Transaksi sudah terkunci (Tutup Kasir), tidak bisa diedit lagi','error');
      editingTxId = null; return navigate('riwayat');
    }
    Object.assign(orig, {
      account_id: acc.id, kategori_id: cat.id, kategori: cat.name, jenis, flow: cat.flow, amount, profit,
      catatan, expense_type: cat.flow==='Pengeluaran' ? window._expenseType : null,
      payment_status: paymentStatus, netral_arah: cat.flow==='Netral' ? (cat.arah||'+') : null,
    });
    runAudit(orig);
    DB.kasbon = DB.kasbon.filter(k=>k.transaction_id!==orig.id);
    if(paymentStatus==='unpaid'){
      DB.kasbon.push({id:uid('kasbon'), transaction_id:orig.id, nama_pelanggan:pelanggan, account_id:acc.id,
        amount, tanggal:orig.tanggal, status:'unpaid', tanggal_lunas:null, catatan});
    }
    saveDB();
    const backId = orig.id; editingTxId = null;
    toast(orig.flag_suspect ? 'Diperbarui, tapi ditandai audit: '+orig.suspect_reasons : 'Transaksi diperbarui', orig.flag_suspect?'error':'ok');
    navigate('txDetail', {id: backId});
    return;
  }

  // ---- mode BARU ----
  // cek lock: akun sudah ditutup-kasir untuk tanggal hari ini?
  const closing = getLatestClosing(acc.id);
  const today = todayStr();
  if(closing && today <= closing.tanggal) return toast('Tanggal ini sudah terkunci (Tutup Kasir). Gunakan transaksi penyesuaian.','error');

  const tx = {
    id: uid('transactions'), tanggal: today, account_id: acc.id, target_account_id: null,
    kategori_id: cat.id, kategori: cat.name, jenis, flow: cat.flow, amount, profit,
    catatan, expense_type: cat.flow==='Pengeluaran' ? window._expenseType : null,
    payment_status: paymentStatus, netral_arah: cat.flow==='Netral' ? (cat.arah||'+') : null,
    kasir_id: DB.currentKasirId, locked:0, flag_suspect:0, suspect_reasons:'', created_at: nowIso()
  };
  runAudit(tx);
  DB.transactions.push(tx);
  if(paymentStatus==='unpaid'){
    DB.kasbon.push({id:uid('kasbon'), transaction_id:tx.id, nama_pelanggan:pelanggan, account_id:acc.id,
      amount, tanggal:today, status:'unpaid', tanggal_lunas:null, catatan});
  }
  saveDB();
  toast(tx.flag_suspect ? 'Tersimpan, tapi ditandai audit: '+tx.suspect_reasons : 'Transaksi tersimpan', tx.flag_suspect?'error':'ok');
  navigate('dashboard');
}

