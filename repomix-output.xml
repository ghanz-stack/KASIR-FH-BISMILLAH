let kpValue = '0'; // string digit mentah
function kpPress(k){
  if(k==='back'){ kpValue = kpValue.length>1 ? kpValue.slice(0,-1) : '0'; }
  else if(k==='clear'){ kpValue = '0'; }
  else { kpValue = (kpValue==='0'? '' : kpValue) + k; if(kpValue.length>12) kpValue = kpValue.slice(0,12); }
  const disp = document.getElementById('kp-display');
  if(disp) disp.textContent = fmtRp(kpValue);
  if(typeof window._kpOnChange==='function') window._kpOnChange(Number(kpValue));
}
function renderKeypad(){
  return `
    <div class="amount-display" id="kp-display">${fmtRp(kpValue)}</div>
    <div class="keypad">
      ${['1','2','3','4','5','6','7','8','9'].map(n=>`<button type="button" class="key" onclick="kpPress('${n}')">${n}</button>`).join('')}
      <button type="button" class="key fn" onclick="kpPress('clear')">C</button>
      <button type="button" class="key" onclick="kpPress('0')">0</button>
      <button type="button" class="key fn" onclick="kpPress('back')">⌫</button>
    </div>`;
}

