/* ---------------- IMPORT / EXPORT CSV ---------------- */
function screenImportExport(){
  return `
    <div class="section-title">Export</div>
    <div class="card">
      <button class="btn" onclick="exportTransaksiCsv()">Export Transaksi (CSV)</button>
      <div style="height:8px"></div>
      <button class="btn btn-outline" onclick="exportAkunCsv()">Export Akun (CSV)</button>
      <div style="height:8px"></div>
      <button class="btn btn-outline" onclick="backupJson()">Backup Semua Data (JSON)</button>
    </div>
    <div class="section-title">Import Transaksi dari CSV</div>
    <div class="card">
      <div class="hint">Kolom wajib: tanggal(YYYY-MM-DD), akun, kategori, jenis, nominal, profit, catatan, status_bayar(lunas/kasbon), nama_pelanggan</div>
      <div style="height:6px"></div>
      <button class="btn btn-outline" onclick="downloadTemplateCsv()">Unduh Template CSV</button>
      <div style="height:10px"></div>
      <input type="file" id="csv-file" accept=".csv,text/csv">
      <div style="height:8px"></div>
      <button class="btn" onclick="importCsv()">Import File CSV</button>
      <div id="import-result" class="hint"></div>
    </div>
  `;
}
function csvEscape(v){ v=String(v==null?'':v); return /[",\n]/.test(v) ? '"'+v.replace(/"/g,'""')+'"' : v; }
function downloadFile(filename, content, mime){
  const blob = new Blob([content], {type:mime||'text/csv;charset=utf-8;'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(a.href), 3000);
}
function exportTransaksiCsv(){
  const header = ['tanggal','akun','akun_tujuan','kategori','jenis','flow','nominal','profit','catatan','status_bayar','expense_type'];
  const rows = DB.transactions.map(t=>[t.tanggal, getAccount(t.account_id)?.name||'', t.target_account_id?getAccount(t.target_account_id)?.name||'':'',
    t.kategori||'', t.jenis, t.flow, t.amount, t.profit, t.catatan||'', t.payment_status, t.expense_type||'']);
  const csv = [header, ...rows].map(r=>r.map(csvEscape).join(',')).join('\n');
  downloadFile('transaksi_export_'+todayStr()+'.csv', csv);
  toast('Export transaksi berhasil','ok');
}
function exportAkunCsv(){
  const header = ['nama','tipe','saldo_awal','ambang_minimum','saldo_sekarang','aktif'];
  const rows = DB.accounts.map(a=>[a.name, a.tipe, a.saldo_awal, a.ambang_minimum, getSaldo(a.id), a.aktif?'ya':'tidak']);
  const csv = [header, ...rows].map(r=>r.map(csvEscape).join(',')).join('\n');
  downloadFile('akun_export_'+todayStr()+'.csv', csv);
  toast('Export akun berhasil','ok');
}
function backupJson(){
  downloadFile('backup_kasir_'+todayStr()+'.json', JSON.stringify(DB, null, 2), 'application/json');
  toast('Backup JSON diunduh','ok');
}
function downloadTemplateCsv(){
  const header = ['tanggal','akun','kategori','jenis','nominal','profit','catatan','status_bayar','nama_pelanggan'];
  const contoh = ['2026-07-20','Kas Laci','Penjualan Barang','Contoh penjualan','50000','10000','','lunas',''];
  downloadFile('template_import_transaksi.csv', [header,contoh].map(r=>r.map(csvEscape).join(',')).join('\n'));
}
function parseCsvLine(line){
  // ponytail: parser CSV sederhana yang tetap menangani tanda kutip dasar, cukup untuk template ini
  const out=[]; let cur=''; let inQ=false;
  for(let i=0;i<line.length;i++){
    const ch=line[i];
    if(inQ){
      if(ch==='"' && line[i+1]==='"'){ cur+='"'; i++; }
      else if(ch==='"'){ inQ=false; }
      else cur+=ch;
    } else {
      if(ch==='"') inQ=true;
      else if(ch===','){ out.push(cur); cur=''; }
      else cur+=ch;
    }
  }
  out.push(cur);
  return out;
}
function importCsv(){
  const fileInput = document.getElementById('csv-file');
  const file = fileInput.files[0];
  if(!file) return toast('Pilih file CSV dulu','error');
  const reader = new FileReader();
  reader.onload = (e)=>{
    const lines = String(e.target.result).split(/\r?\n/).filter(l=>l.trim().length);
    if(lines.length<2) return toast('File CSV kosong','error');
    const header = parseCsvLine(lines[0]).map(h=>h.trim().toLowerCase());
    let ok=0, fail=0; const errors=[];
    for(let i=1;i<lines.length;i++){
      const cols = parseCsvLine(lines[i]);
      const row = {}; header.forEach((h,idx)=>row[h]=(cols[idx]||'').trim());
      try{
        const acc = DB.accounts.find(a=>a.name.toLowerCase()===String(row.akun||'').toLowerCase());
        if(!acc) throw new Error('akun "'+row.akun+'" tidak ditemukan');
        let cat = DB.categories.find(c=>c.name.toLowerCase()===String(row.kategori||'').toLowerCase());
        if(!cat) throw new Error('kategori "'+row.kategori+'" tidak ditemukan');
        const amount = Number(row.nominal); if(!amount || amount<=0) throw new Error('nominal tidak valid');
        const isUnpaid = String(row.status_bayar||'').toLowerCase().startsWith('kasbon');
        if(isUnpaid && !row.nama_pelanggan) throw new Error('nama_pelanggan wajib untuk kasbon');
        const tanggal = row.tanggal || todayStr();
        const tx = {id:uid('transactions'), tanggal, account_id:acc.id, target_account_id:null,
          kategori_id:cat.id, kategori:cat.name, jenis: row.jenis||cat.name, flow:cat.flow,
          amount, profit: Number(row.profit||0), catatan: row.catatan||'',
          expense_type: cat.flow==='Pengeluaran' ? 'OPEX' : null,
          payment_status: isUnpaid?'unpaid':'paid', netral_arah: cat.flow==='Netral'?(cat.arah||'+'):null,
          kasir_id: DB.currentKasirId, locked:0, flag_suspect:0, suspect_reasons:'', created_at:nowIso()};
        runAudit(tx);
        DB.transactions.push(tx);
        if(isUnpaid) DB.kasbon.push({id:uid('kasbon'), transaction_id:tx.id, nama_pelanggan:row.nama_pelanggan,
          account_id:acc.id, amount, tanggal, status:'unpaid', tanggal_lunas:null, catatan:row.catatan||''});
        ok++;
      }catch(err){ fail++; errors.push('Baris '+(i+1)+': '+err.message); }
    }
    saveDB();
    document.getElementById('import-result').innerHTML = `${ok} baris berhasil, ${fail} gagal.` +
      (errors.length? '<br>'+errors.slice(0,8).map(esc).join('<br>') : '');
    toast(`Import selesai: ${ok} berhasil, ${fail} gagal`, fail?'error':'ok');
  };
  reader.readAsText(file);
}

/* ============================ LOCK SCREEN ============================ */
let lockSelectedKasir = null;
let lockPin = '';
function renderLock(){
  const lock = document.getElementById('lockscreen');
  lock.style.display = 'flex';
  if(DB.kasir.length===0){ lock.innerHTML = renderLockSetup(); return; }
  if(!lockSelectedKasir){ lock.innerHTML = renderLockSelect(); return; }
  const k = getKasir(lockSelectedKasir);
  if(!k){ lockSelectedKasir=null; lock.innerHTML = renderLockSelect(); return; }
  if(!k.pin_hash){ DB.currentKasirId = k.id; saveDB(); lockSelectedKasir=null; render(); return; }
  lock.innerHTML = renderLockPin(k);
}
function renderLockSetup(){
