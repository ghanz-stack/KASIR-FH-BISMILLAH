<title>Kasir Front House</title>
<style>
:root{
  --primary:#0F766E; --primary-dark:#0b5c56; --primary-light:#14b8a6;
  --ewallet:#10b981; --bank:#3b82f6; --cash:#f59e0b; --voucher:#8b5cf6;
