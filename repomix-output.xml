<body>
<div id="app-root">
  <div id="topbar" class="topbar"></div>
  <div id="screen"></div>
  <div id="bottomnav" class="bottomnav"></div>
</div>
<div id="toast"></div>
<div id="lockscreen" style="display:none;"></div>

<script>
/* =====================================================================
   KASIR FRONT HOUSE — Android Web App (single-file, offline-first)
   Basis: Blueprint Sistem Kasir v3
   Penyimpanan: localStorage (menggantikan SQLite native untuk versi web).
   ponytail: 1 file, 1 key storage, tanpa build step, tanpa dependency luar.
   ===================================================================== */

const STORE_KEY = 'kasirAppDataV1';
const ACC_COLOR = {ewallet:'var(--ewallet)', bank:'var(--bank)', cash:'var(--cash)',
  voucher:'var(--voucher)', barang:'var(--barang)', ppob_server:'var(--ppob)'};
const ACC_LABEL = {ewallet:'E-Wallet', bank:'Bank', cash:'Cash', voucher:'Voucher',
  barang:'Barang', ppob_server:'PPOB Server'};

let DB = null;

function nowIso(){ return new Date().toISOString(); }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function uid(table){ const id = DB.nextId[table]++; return id; }
function fmtRp(n){ n = Math.round(Number(n)||0); const neg = n<0; n=Math.abs(n);
  return (neg?'-':'')+'Rp '+n.toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.'); }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function toast(msg, type){
  const t = document.getElementById('toast');
  t.textContent = (type==='error'?'⚠ ':type==='ok'?'✓ ':'') + msg;
  t.style.background = type==='error' ? '#991b1b' : type==='ok' ? '#065f46' : '#0f172a';
  t.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(()=>t.classList.remove('show'), 2400);
}

function seedIfEmpty(){
  const acc = (name, tipe) => { const id = uid('accounts'); DB.accounts.push({id, name, tipe, saldo_awal:0, ambang_minimum:0, aktif:1}); return id; };
  const cat = (name, account_ids) => { DB.categories.push({id:uid('categories'), name, flow:'Pemasukan', account_ids}); };

  const dana = [1,2,3,4].map(n=>acc('DANA '+n, 'ewallet'));
  const seaBank = acc('Sea Bank', 'bank');
  const shopeepay = acc('Shopeepay', 'ewallet');
  const saveplus = acc('Saveplus', 'ppob_server');
  const fastpay = acc('Fastpay', 'ppob_server');
  const mandiri = acc('Mandiri', 'bank');
  const cash = acc('Cash', 'cash');
  const voucherFisik = acc('Voucher Fisik', 'voucher');
  const barang = acc('Barang', 'barang');

  ['Tarik','Setor','Transfer','Lainnya'].forEach(n=>cat(n, dana));
  ['Tarik','Setor','Transfer','Lainnya'].forEach(n=>cat(n, [seaBank]));
  ['Transfer','Listrik','BRI VA','Gopay','Lainnya'].forEach(n=>cat(n, [shopeepay]));
  ['Paket Data','Pulsa','Lainnya'].forEach(n=>cat(n, [saveplus]));
  ['EDC','Topup','Paket Data','Pulsa','Lainnya'].forEach(n=>cat(n, [fastpay]));
  ['Transfer','Setor','Tarik Tunai','Lainnya'].forEach(n=>cat(n, [mandiri]));
  ['Tarik','Setor'].forEach(n=>cat(n, [cash]));
  ['Paket Data & Perdana','Telkomsel','Tri','Indosat','Axis','Smartfren','XL'].forEach(n=>cat(n, [voucherFisik]));
  ['Kabel','Charger','Mainan','Tempered Glass','Casing','Lainnya'].forEach(n=>cat(n, [barang]));

  // kategori umum, berlaku lintas akun (account_ids null = global)
  DB.categories.push(
    {id:uid('categories'), name:'Belanja Stok', flow:'Pengeluaran', account_ids:null},
    {id:uid('categories'), name:'Biaya Operasional', flow:'Pengeluaran', account_ids:null},
    {id:uid('categories'), name:'Setoran Pemilik', flow:'Netral', arah:'+', account_ids:null},
    {id:uid('categories'), name:'Ambil Pribadi (Prive)', flow:'Netral', arah:'-', account_ids:null}
  );

  DB.kasir.push({id:uid('kasir'), nama:'Admin', pin_hash:null, pin_salt:null, aktif:1});
}

function loadDB(){
  const raw = localStorage.getItem(STORE_KEY);
  if(raw){ try{ DB = JSON.parse(raw); }catch(e){ DB = null; } }
  if(!DB){
    DB = {accounts:[], categories:[], transactions:[], kasbon:[], kasir:[], closings:[],
      nextId:{accounts:1,categories:1,transactions:1,kasbon:1,kasir:1,closings:1}, currentKasirId:null};
    seedIfEmpty();
    saveDB();
  }
  if(!DB.closings) DB.closings=[];
  if(!DB.nextId.closings) DB.nextId.closings=1;
  DB.categories.forEach(c=>{ if(c.aktif===undefined) c.aktif=1; });
  if(!DB.settings) DB.settings = {fontScale:'regular'};
  if(!DB.settings.fontScale) DB.settings.fontScale = 'regular';
  applyFontScale();
}
function saveDB(){ localStorage.setItem(STORE_KEY, JSON.stringify(DB)); }

/* ---------- getters ---------- */
function getAccount(id){ return DB.accounts.find(a=>a.id===id); }
function getCategory(id){ return DB.categories.find(c=>c.id===id); }
function getKasir(id){ return DB.kasir.find(k=>k.id===id); }
function activeAccounts(){ return DB.accounts.filter(a=>a.aktif); }

/* strategi saldo bertingkat: checkpoint tutup-kasir terakhir + transaksi setelahnya */
function getLatestClosing(accountId){
  const list = DB.closings.filter(c=>c.account_id===accountId).sort((a,b)=>b.tanggal.localeCompare(a.tanggal));
  return list[0] || null;
}
function getSaldo(accountId){ return getSaldoAsOf(accountId, todayStr()); }
/* saldo per posisi akhir tanggal tertentu (dipakai Tutup Kasir susulan agar transaksi
   SETELAH tanggal yang ditutup tidak ikut kehitung/kekunci) */
function getSaldoAsOf(accountId, tanggal){
  const acc = getAccount(accountId); if(!acc) return 0;
  const closing = getLatestClosing(accountId);
  let base = closing ? closing.saldo_fisik : acc.saldo_awal;
  const afterDate = closing ? closing.tanggal : null;
  let total = base;
  for(const tx of DB.transactions){
    if(afterDate && tx.tanggal <= afterDate) continue;
    if(tx.tanggal > tanggal) continue; // exclude transaksi setelah tanggal yang dihitung
    if(tx.payment_status === 'unpaid') continue; // kasbon: belum masuk kas riil
    if(tx.account_id===accountId){
      if(tx.flow==='Pemasukan') total += tx.amount;
      else if(tx.flow==='Pengeluaran') total -= tx.amount;
      else if(tx.flow==='Netral') total += (tx.netral_arah==='-'? -tx.amount : tx.amount);
      else if(tx.flow==='Mutasi') total -= tx.amount; // sebagai akun asal
    }
    if(tx.target_account_id===accountId && tx.flow==='Mutasi'){
      total += tx.amount; // sebagai akun tujuan
    }
  }
  return total;
}
function addDays(dateStr, n){
  const d = new Date(dateStr+'T00:00:00Z'); d.setUTCDate(d.getUTCDate()+n); return d.toISOString().slice(0,10);
}
/* tanggal default yang harus ditutup untuk akun ini: hari tertua yang masih belum
   dikunci sejak closing terakhir (memaksa penutupan berurutan, tidak boleh loncat) */
function defaultClosingDate(accountId){
  const closing = getLatestClosing(accountId);
  const dates = DB.transactions
    .filter(t=>!t.locked && (t.account_id===accountId || t.target_account_id===accountId))
    .map(t=>t.tanggal)
    .filter(d=> !closing || d>closing.tanggal)
    .sort();
  return dates[0] || todayStr();
}

/* ---------- audit ---------- */
function runAudit(tx){
  const reasons = [];
  const twoMinAgo = Date.now() - 2*60*1000;
  const dup = DB.transactions.find(t => t.id!==tx.id && t.account_id===tx.account_id && t.amount===tx.amount &&
    t.kategori_id===tx.kategori_id && new Date(t.created_at).getTime() >= twoMinAgo);
  if(dup) reasons.push('Kemungkinan duplikat entri (akun, kategori, nominal sama dalam 2 menit terakhir)');

  const sejenis = DB.transactions.filter(t=>t.kategori_id===tx.kategori_id && t.id!==tx.id).slice(-20);
  if(sejenis.length >= 5){
    const avg = sejenis.reduce((s,t)=>s+t.amount,0)/sejenis.length;
    if(avg>0 && tx.amount > avg*3) reasons.push('Nominal jauh di atas rata-rata transaksi kategori ini (>3x rata-rata)');
  }
  tx.flag_suspect = reasons.length ? 1 : 0;
  tx.suspect_reasons = reasons.join('; ');
}

/* ---------- navigasi ---------- */
let navStack = ['dashboard'];
let navParams = {};
const TABS = ['dashboard','input','transfer','riwayat','setting'];

function currentScreen(){ return navStack[navStack.length-1]; }
function navigate(screen, params){
  navParams = params || {};
  if(TABS.includes(screen)){ navStack = [screen]; }
  else { navStack.push(screen); }
  history.pushState({nav:navStack.length}, '', '#'+screen);
  render();
}
function goBack(){
  if(navStack.length>1){ navStack.pop(); render(); }
  else { navigate('dashboard'); }
}
window.addEventListener('popstate', ()=>{ if(navStack.length>1){ navStack.pop(); render(); } });

/* auto-lock saat app di-background > 60 detik */
let hiddenAt = null;
document.addEventListener('visibilitychange', ()=>{
  if(document.hidden){ hiddenAt = Date.now(); }
  else if(hiddenAt && Date.now()-hiddenAt > 60000){ DB.currentKasirId=null; hiddenAt=null; render(); }
});

/* ---------- PIN hashing ----------
   crypto.subtle butuh secure context (https/localhost). Jika file dibuka
   langsung dari disk (file://) atau WebView non-https, fallback ke hash
   sederhana — cukup untuk PIN lokal 4-6 digit (bukan pengganti auth server). */
async function sha256(text){
  if(window.crypto && window.crypto.subtle){
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
  }
  return simpleHash(text);
}
function simpleHash(text){
  // ponytail: FNV-1a 32-bit, fallback saja saat Web Crypto tak tersedia
  let h = 0x811c9dc5;
  for(let i=0;i<text.length;i++){ h ^= text.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h>>>0).toString(16).padStart(8,'0');
}
function randomSalt(){ return Math.random().toString(36).slice(2)+Date.now().toString(36); }

/* ============================ RENDER ============================ */
function render(){
  if(!DB.currentKasirId){ renderLock(); return; }
  document.getElementById('lockscreen').style.display='none';
  const screen = currentScreen();
  document.getElementById('topbar').innerHTML = renderTopbar(screen);
  const el = document.getElementById('screen');
  el.innerHTML = renderScreen(screen);
  el.classList.remove('slide'); void el.offsetWidth; el.classList.add('slide');
  el.scrollTop = 0;
  document.getElementById('bottomnav').innerHTML = renderBottomNav(screen);
}

function renderTopbar(screen){
  const titles = {dashboard:'🏠 Dashboard', input:'➕ Input Transaksi', transfer:'🔁 Pindah Saldo', riwayat:'📜 Riwayat',
    setting:'⚙️ Pengaturan', kasbon:'💰 Kasbon', tutupkasir:'⛔ Tutup Kasir', laporan:'📝 Laporan', audit:'📃 Audit Log',
    settingAkun:'🧍 Kelola Akun', settingKategori:'📎 Kelola Kategori', settingKasir:'💻 Kelola Kasir & PIN',
    settingImportExport:'📕 Import / Export CSV', settingFont:'⚡ Ukuran Font', txDetail:'💹 Detail Transaksi',
    editTx:'✏️ Edit Transaksi'};
