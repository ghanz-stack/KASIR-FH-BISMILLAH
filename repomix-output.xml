    <button class="navbtn ${screen===id?'active':''}" onclick="navigate('${id}')">
      <span class="ic">${ic}</span><span>${label}</span>
    </button>`).join('');
}

function renderScreen(screen){
  switch(screen){
    case 'dashboard': return screenDashboard();
