function lockNow(){ DB.currentKasirId=null; render(); }

function renderBottomNav(screen){
  const items = [
    ['dashboard','🏠','Dashboard'], ['input','➕','Input'], ['transfer','🔁','Pindah'],
    ['riwayat','📜','Riwayat'], ['setting','⚙️','Setting']
