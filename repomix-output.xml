  padding-bottom:env(safe-area-inset-bottom);}
#screen{flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; padding:14px 14px 90px 14px;}
#screen.slide{animation:slideIn .22s ease-out;}
@keyframes slideIn{from{opacity:0; transform:translateX(16px);} to{opacity:1; transform:translateX(0);}}

/* Top bar */
.topbar{display:flex; align-items:center; gap:10px; padding:12px 14px; background:linear-gradient(135deg,var(--primary),var(--primary-light));
  color:#fff; box-shadow:0 2px 8px rgba(15,118,110,.25); position:relative; z-index:5;}
.topbar h1{font-size:calc(16px * var(--fs-mult)); margin:0; font-weight:700; flex:1;}
.back-btn{background:rgba(255,255,255,.18); border:none; color:#fff; width:34px; height:34px; border-radius:10px;
  font-size:calc(18px * var(--fs-mult)); display:flex; align-items:center; justify-content:center;}
.kasir-chip{font-size:calc(11px * var(--fs-mult)); background:rgba(255,255,255,.18); padding:5px 10px; border-radius:20px; white-space:nowrap;}
.lock-btn{background:rgba(255,255,255,.18); border:none; color:#fff; width:32px; height:32px; border-radius:10px; font-size:calc(15px * var(--fs-mult));}

/* Bottom nav */
.bottomnav{position:fixed; left:0; right:0; bottom:0; display:flex; background:var(--card);
  box-shadow:0 -2px 12px rgba(0,0,0,.08); padding-bottom:env(safe-area-inset-bottom); z-index:10;}
.navbtn{flex:1; border:none; background:none; padding:9px 2px 8px; display:flex; flex-direction:column;
  align-items:center; gap:2px; color:var(--muted); font-size:calc(10.5px * var(--fs-mult)); font-weight:600;}
.navbtn.active{color:var(--primary);}
.navbtn .ic{font-size:calc(19px * var(--fs-mult));}

/* Cards */
.card{background:var(--card); border-radius:16px; padding:16px; margin-bottom:12px; box-shadow:0 1px 3px rgba(0,0,0,.06);}
.card-hero{background:linear-gradient(135deg,var(--primary),var(--primary-light)); color:#fff; border-radius:18px;
  padding:18px; margin-bottom:12px; box-shadow:0 6px 16px rgba(15,118,110,.25);}
.card-hero .lbl{font-size:calc(12px * var(--fs-mult)); opacity:.85; font-weight:600;}
