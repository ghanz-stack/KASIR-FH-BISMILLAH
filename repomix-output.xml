  const pin = document.getElementById('setup-pin').value.trim();
  let pin_hash=null, pin_salt=null;
  if(pin && pin.length>=4){ pin_salt=randomSalt(); pin_hash = await sha256(pin+pin_salt); }
  const id = uid('kasir');
  DB.kasir.push({id, nama, pin_hash, pin_salt, aktif:1});
  DB.currentKasirId = id; saveDB(); render();
}
function renderLockSelect(){
  const kasirs = DB.kasir.filter(k=>k.aktif);
  return `
    <div class="lock-inner">
      <div class="lock-logo">🧾</div>
      <div class="lock-title">Kasir Front House</div>
      <div class="lock-sub">Pilih kasir untuk masuk</div>
      <div class="kasir-tiles">
        ${kasirs.map(k=>`<button class="kasir-tile" onclick="lockSelectedKasir=${k.id}; renderLock();">
          <div class="kasir-avatar">${esc(k.nama.slice(0,1).toUpperCase())}</div>
          <div style="font-size:calc(11.5px * var(--fs-mult));font-weight:700;">${esc(k.nama)}</div>
        </button>`).join('')}
      </div>
    </div>`;
}
function renderLockPin(k){
  const dots = Array.from({length:6}).map((_,i)=>`<div class="pin-dot ${i<lockPin.length?'filled':''}"></div>`).join('');
  return `
    <div class="lock-inner">
      <div class="lock-logo">🔒</div>
      <div class="lock-title">${esc(k.nama)}</div>
      <div class="lock-sub">Masukkan PIN</div>
      <div class="pin-dots">${dots}</div>
      <div class="pin-keypad">
        ${['1','2','3','4','5','6','7','8','9'].map(n=>`<button class="pin-key" onclick="pinPress('${n}')">${n}</button>`).join('')}
        <span></span>
        <button class="pin-key" onclick="pinPress('0')">0</button>
        <button class="pin-key" onclick="pinPress('back')">⌫</button>
      </div>
      <button class="linklike" onclick="lockSelectedKasir=null; lockPin=''; renderLock();">← Ganti Kasir</button>
    </div>`;
}
async function pinPress(k){
  if(k==='back'){ lockPin = lockPin.slice(0,-1); renderLock(); return; }
  if(lockPin.length>=6) return;
  lockPin += k;
  const kasir = getKasir(lockSelectedKasir);
  if(lockPin.length >= 4){
    const hash = await sha256(lockPin + kasir.pin_salt);
    if(hash === kasir.pin_hash){ DB.currentKasirId = kasir.id; lockSelectedKasir=null; lockPin=''; saveDB(); render(); return; }
    if(lockPin.length===6 || lockPin.length===kasir.pin_hash.length || true){
      // beri kesempatan lanjut mengetik sampai batas wajar, cek ulang tiap ketukan
    }
  }
  renderLock();
  if(lockPin.length>=6){
    setTimeout(()=>{ toast('PIN salah','error'); lockPin=''; renderLock(); }, 200);
  }
}

