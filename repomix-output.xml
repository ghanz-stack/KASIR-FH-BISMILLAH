const FONT_SCALE_MULT = {small:0.85, regular:1, medium:1.15, large:1.3};
function applyFontScale(){
  document.documentElement.style.setProperty('--fs-mult', FONT_SCALE_MULT[DB.settings.fontScale] || 1);
}
function setFontScale(level){
  if(!FONT_SCALE_MULT[level]) return;
  DB.settings.fontScale = level;
  saveDB();
  applyFontScale();
  document.getElementById('screen').innerHTML = screenSettingFont();
}

