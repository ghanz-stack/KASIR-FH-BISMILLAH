    transferState.source = accs[0]?.id || null;
    transferState.target = accs[1]?.id || accs[0]?.id || null;
  }
  return `
    <label class="f">Akun Asal</label>
    <div class="seg" id="src-seg">
      ${accs.map(a=>`<button type="button" class="seg-btn ${a.id===transferState.source?'sel':''}"
        style="${a.id===transferState.source?`background:${ACC_COLOR[a.tipe]}`:''}"
        onclick="selTransferSrc(${a.id})">${esc(a.name)}</button>`).join('')}
    </div>
    <label class="f">Akun Tujuan</label>
    <div class="seg" id="tgt-seg">
      ${accs.map(a=>`<button type="button" class="seg-btn ${a.id===transferState.target?'sel':''}"
        style="${a.id===transferState.target?`background:${ACC_COLOR[a.tipe]}`:''}"
        onclick="selTransferTgt(${a.id})">${esc(a.name)}</button>`).join('')}
    </div>

    <label class="f">Nominal</label>
    ${renderKeypad()}

    <div class="card-sub" id="transfer-preview">${transferPreviewHtml()}</div>

    <label class="f">Catatan (opsional)</label>
    <textarea id="tr-catatan" placeholder="mis. Setor kas laci ke Sea Bank" onfocus="scrollToMe(this)"></textarea>

    <div style="height:10px"></div>
    <button class="btn" style="background:var(--mutasi)" onclick="submitTransfer()">Pindahkan Saldo</button>
  `;
}
window._kpOnChange = ()=>{ const el=document.getElementById('transfer-preview'); if(el) el.innerHTML = transferPreviewHtml(); };
function transferPreviewHtml(){
  if(!transferState.source || !transferState.target) return '<div class="hint">Pilih akun asal & tujuan.</div>';
  if(transferState.source === transferState.target) return '<div class="hint" style="color:var(--danger)">Akun asal & tujuan tidak boleh sama.</div>';
  const amt = Number(kpValue);
  const sAcc = getAccount(transferState.source), tAcc = getAccount(transferState.target);
  const sBefore = getSaldo(sAcc.id), tBefore = getSaldo(tAcc.id);
  return `
    <div class="lbl">PREVIEW SALDO</div>
    <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:calc(12.5px * var(--fs-mult));">
      <span>${esc(sAcc.name)}: ${fmtRp(sBefore)} → <b style="color:var(--danger)">${fmtRp(sBefore-amt)}</b></span>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:calc(12.5px * var(--fs-mult));">
      <span>${esc(tAcc.name)}: ${fmtRp(tBefore)} → <b style="color:var(--success)">${fmtRp(tBefore+amt)}</b></span>
    </div>
    ${amt > sBefore ? '<div class="hint" style="color:var(--danger)">Nominal melebihi saldo akun asal.</div>':''}
  `;
}
function selTransferSrc(id){ transferState.source=id; rerenderTransferPartial(); }
function selTransferTgt(id){ transferState.target=id; rerenderTransferPartial(); }
function rerenderTransferPartial(){
  const keep = kpValue;
  document.getElementById('screen').innerHTML = screenTransfer(false);
  kpValue = keep;
  const disp = document.getElementById('kp-display'); if(disp) disp.textContent = fmtRp(kpValue);
  const pv = document.getElementById('transfer-preview'); if(pv) pv.innerHTML = transferPreviewHtml();
}
function submitTransfer(){
  const amount = Number(kpValue);
  if(!amount || amount<=0) return toast('Nominal harus diisi','error');
  if(transferState.source === transferState.target) return toast('Akun asal & tujuan tidak boleh sama','error');
  const sAcc = getAccount(transferState.source), tAcc = getAccount(transferState.target);
  const sBefore = getSaldo(sAcc.id);
  if(amount > sBefore) return toast('Saldo akun asal tidak mencukupi','error');
  const catatan = document.getElementById('tr-catatan').value.trim();
  const today = todayStr();
  const closing = getLatestClosing(sAcc.id);
  if(closing && today <= closing.tanggal) return toast('Akun asal sudah terkunci (Tutup Kasir)','error');
  const closingTgt = getLatestClosing(tAcc.id);
  if(closingTgt && today <= closingTgt.tanggal) return toast('Akun tujuan sudah terkunci (Tutup Kasir)','error');

  const tx = {id: uid('transactions'), tanggal: today, account_id: sAcc.id, target_account_id: tAcc.id,
    kategori_id:null, kategori:'Mutasi Saldo', jenis:'Pindah Saldo', flow:'Mutasi', amount, profit:0,
    catatan, expense_type:null, payment_status:'paid', netral_arah:null,
    kasir_id: DB.currentKasirId, locked:0, flag_suspect:0, suspect_reasons:'', created_at: nowIso()};
  runAudit(tx);
  DB.transactions.push(tx);
  saveDB();
  toast('Saldo berhasil dipindahkan','ok');
  navigate('dashboard');
}

/* ---------------- RIWAYAT ---------------- */
let riwayatFilter = 'all';
let riwayatLimit = 30;
function screenRiwayat(){
  let list = DB.transactions.slice().sort((a,b)=> (b.tanggal+String(b.id).padStart(6,'0')).localeCompare(a.tanggal+String(a.id).padStart(6,'0')));
  if(riwayatFilter!=='all') list = list.filter(t=>t.flow===riwayatFilter);
  const shown = list.slice(0, riwayatLimit);
  const tabs = [['all','Semua'],['Pemasukan','Masuk'],['Pengeluaran','Keluar'],['Mutasi','Mutasi'],['Netral','Netral']];
  return `
    <div class="tabs">
      ${tabs.map(([id,label])=>`<div class="tab ${riwayatFilter===id?'sel':''}" onclick="setRiwayatFilter('${id}')">${label}</div>`).join('')}
    </div>
    <div class="card" style="padding:6px 14px;">
      ${shown.length? shown.map(t=>renderTxRow(t)).join('') : `<div class="empty-state"><div class="ic">📭</div>Belum ada transaksi.</div>`}
    </div>
    ${list.length > shown.length ? `<button class="btn btn-outline" onclick="riwayatLimit+=30; document.getElementById('screen').innerHTML=screenRiwayat();">Muat Lebih Banyak</button>` : ''}
  `;
}
function setRiwayatFilter(f){ riwayatFilter=f; riwayatLimit=30; document.getElementById('screen').innerHTML = screenRiwayat(); }
function renderTxRow(t){
  const acc = getAccount(t.account_id);
  const color = t.flow==='Mutasi' ? 'var(--mutasi)' : t.flow==='Pemasukan' ? 'var(--success)' : t.flow==='Pengeluaran' ? 'var(--danger)' : 'var(--muted)';
  const sign = t.flow==='Pengeluaran' ? '-' : t.flow==='Pemasukan' ? '+' : t.flow==='Mutasi' ? '⇄' : '•';
  const badges = [];
  if(t.flow==='Mutasi') badges.push('<span class="badge badge-mutasi">Mutasi</span>');
  if(t.payment_status==='unpaid') badges.push('<span class="badge badge-unpaid">Kasbon</span>');
  if(t.locked) badges.push('<span class="badge badge-locked">🔒</span>');
  if(t.flag_suspect) badges.push('<span class="badge badge-out">⚑ Audit</span>');
  return `
    <div class="row-item" onclick="navigate('txDetail',{id:${t.id}})">
      <div class="row-dot" style="background:${color}"></div>
      <div class="row-main">
        <div class="row-title">${esc(t.jenis)} ${badges.join(' ')}</div>
        <div class="row-sub">${esc(acc?acc.name:'-')} ${t.target_account_id? '→ '+esc(getAccount(t.target_account_id)?.name||'-') : ''} · ${t.tanggal}</div>
      </div>
      <div class="row-amt" style="color:${color}">${sign} ${fmtRp(t.amount)}</div>
    </div>`;
}
function screenTxDetail(){
  const t = DB.transactions.find(x=>x.id===navParams.id);
  if(!t) return '<div class="empty-state">Transaksi tidak ditemukan.</div>';
  const acc = getAccount(t.account_id);
  return `
    <div class="card">
      <div class="section-title" style="margin-top:0">${t.flow}</div>
      <div style="font-size:calc(19px * var(--fs-mult));font-weight:800;margin-bottom:10px;">${fmtRp(t.amount)}</div>
      <div class="row-item"><div class="row-main"><div class="row-sub">Tanggal</div><div class="row-title">${t.tanggal}</div></div></div>
      <div class="row-item"><div class="row-main"><div class="row-sub">Akun</div><div class="row-title">${esc(acc?acc.name:'-')}${t.target_account_id?' → '+esc(getAccount(t.target_account_id)?.name||'-'):''}</div></div></div>
      <div class="row-item"><div class="row-main"><div class="row-sub">Kategori / Deskripsi</div><div class="row-title">${esc(t.kategori||'-')} — ${esc(t.jenis)}</div></div></div>
      ${t.profit? `<div class="row-item"><div class="row-main"><div class="row-sub">Profit</div><div class="row-title">${fmtRp(t.profit)}</div></div></div>`:''}
      ${t.expense_type? `<div class="row-item"><div class="row-main"><div class="row-sub">Jenis Beban</div><div class="row-title">${t.expense_type}</div></div></div>`:''}
      <div class="row-item"><div class="row-main"><div class="row-sub">Status Bayar</div><div class="row-title">${t.payment_status==='paid'?'Lunas':'Kasbon (Belum Bayar)'}</div></div></div>
      ${t.catatan? `<div class="row-item"><div class="row-main"><div class="row-sub">Catatan</div><div class="row-title">${esc(t.catatan)}</div></div></div>`:''}
      ${t.flag_suspect? `<div class="row-item"><div class="row-main"><div class="row-sub" style="color:var(--danger)">Ditandai Audit</div><div class="row-title">${esc(t.suspect_reasons)}</div></div></div>`:''}
      ${t.locked? `<div class="hint" style="color:var(--danger);margin-top:6px;">🔒 Terkunci — sudah masuk periode Tutup Kasir, tidak bisa diubah/dihapus. Buat transaksi penyesuaian baru jika perlu koreksi.</div>`
        : `<div class="btn-row" style="margin-top:14px;gap:8px;">
             <button class="btn" style="background:var(--primary)" onclick="startEditTx(${t.id})">Edit Transaksi</button>
             <button class="btn btn-danger" onclick="deleteTx(${t.id})">Hapus Transaksi</button>
           </div>`}
    </div>
  `;
}
let editingTxId = null;
function startEditTx(id){
  const t = DB.transactions.find(x=>x.id===id);
  if(!t || t.locked) return toast('Transaksi terkunci, tidak bisa diedit','error');
  editingTxId = id;
  kpValue = String(t.amount);
  inputState = {account_id: t.account_id, category_id: t.kategori_id, payment_status: t.payment_status};
  window._expenseType = t.expense_type || 'COGS';
  navigate('editTx');
}
function deleteTx(id){
  const t = DB.transactions.find(x=>x.id===id);
  if(!t || t.locked) return toast('Transaksi terkunci, tidak bisa dihapus','error');
  if(!confirm('Hapus transaksi ini?')) return;
  DB.transactions = DB.transactions.filter(x=>x.id!==id);
  DB.kasbon = DB.kasbon.filter(k=>k.transaction_id!==id);
  saveDB(); toast('Transaksi dihapus','ok'); navigate('riwayat');
}

/* ---------------- KASBON ---------------- */
function screenKasbon(){
  const unpaid = DB.kasbon.filter(k=>k.status==='unpaid').sort((a,b)=>a.tanggal.localeCompare(b.tanggal));
  const paid = DB.kasbon.filter(k=>k.status==='paid').slice(-15).reverse();
  return `
    <div class="section-title">Belum Lunas (${unpaid.length})</div>
    <div class="card" style="padding:6px 14px;">
      ${unpaid.length? unpaid.map(k=>{
        const jatuhTempo = (Date.now()-new Date(k.tanggal).getTime())>7*86400000;
        return `<div class="row-item">
          <div class="row-dot" style="background:${jatuhTempo?'var(--danger)':'var(--warning)'}"></div>
          <div class="row-main">
            <div class="row-title">${esc(k.nama_pelanggan)} ${jatuhTempo?'<span class="badge badge-out">Jatuh Tempo</span>':''}</div>
            <div class="row-sub">${k.tanggal} · akun ${esc(getAccount(k.account_id)?.name||'-')}</div>
          </div>
          <div class="row-amt" style="color:var(--warning)">${fmtRp(k.amount)}</div>
        </div>
        <div style="padding:0 0 10px 19px;"><button class="btn btn-sm" onclick="lunasiKasbon(${k.id})">Tandai Lunas</button></div>`;
      }).join('') : `<div class="empty-state"><div class="ic">✅</div>Tidak ada kasbon tertunda.</div>`}
    </div>
    <div class="section-title">Riwayat Lunas</div>
    <div class="card" style="padding:6px 14px;">
      ${paid.length? paid.map(k=>`<div class="row-item">
          <div class="row-dot" style="background:var(--success)"></div>
          <div class="row-main"><div class="row-title">${esc(k.nama_pelanggan)}</div>
          <div class="row-sub">Lunas ${k.tanggal_lunas}</div></div>
          <div class="row-amt" style="color:var(--success)">${fmtRp(k.amount)}</div>
        </div>`).join('') : `<div class="empty-state">Belum ada riwayat.</div>`}
    </div>
  `;
}
function lunasiKasbon(id){
  const k = DB.kasbon.find(x=>x.id===id); if(!k) return;
  if(!confirm(`Tandai kasbon ${k.nama_pelanggan} sebesar ${fmtRp(k.amount)} sebagai lunas?`)) return;
  const cashAcc = DB.accounts.find(a=>a.tipe==='cash' && a.aktif) || DB.accounts[0];
  if(!cashAcc) return toast('Tidak ada akun kas aktif untuk menerima pelunasan','error');
  const closing = getLatestClosing(cashAcc.id);
  const today = todayStr();
  if(closing && today <= closing.tanggal) return toast('Akun kas ('+cashAcc.name+') sudah terkunci (Tutup Kasir), tidak bisa terima pelunasan hari ini','error');
  k.status='paid'; k.tanggal_lunas = today;
  const tx = {id:uid('transactions'), tanggal: today, account_id: cashAcc.id, target_account_id:null,
    kategori_id:null, kategori:'Pelunasan Kasbon', jenis:'Pelunasan kasbon: '+k.nama_pelanggan, flow:'Pemasukan',
    amount:k.amount, profit:0, catatan:'Pelunasan kasbon #'+k.id, expense_type:null, payment_status:'paid',
    netral_arah:null, kasir_id:DB.currentKasirId, locked:0, flag_suspect:0, suspect_reasons:'', created_at:nowIso()};
  DB.transactions.push(tx);
  saveDB(); toast('Kasbon dilunasi','ok'); navigate('kasbon');
}

/* ---------------- TUTUP KASIR ---------------- */
let closingAccId = null;
let closingTanggal = null;
function screenTutupKasir(){
  closingAccId = closingAccId || activeAccounts()[0]?.id;
  if(!closingTanggal) closingTanggal = defaultClosingDate(closingAccId);
  const acc = getAccount(closingAccId);
  const lastClosing = getLatestClosing(closingAccId);
  const minDate = lastClosing ? addDays(lastClosing.tanggal, 1) : null;
  const today = todayStr();
  const saldoSistem = acc? getSaldoAsOf(acc.id, closingTanggal) : 0;
  const isBackfill = closingTanggal < today;
  const relatedKasbon = DB.kasbon.filter(k=>k.status==='unpaid' && k.account_id===closingAccId && k.tanggal===closingTanggal);
  return `
    <label class="f">Pilih Akun</label>
    <div class="seg">
      ${activeAccounts().map(a=>`<button type="button" class="seg-btn ${a.id===closingAccId?'sel':''}"
        style="${a.id===closingAccId?`background:${ACC_COLOR[a.tipe]}`:''}"
        onclick="closingAccId=${a.id}; closingTanggal=null; document.getElementById('screen').innerHTML=screenTutupKasir();">${esc(a.name)}</button>`).join('')}
    </div>
    <label class="f">Tanggal Tutup Kasir</label>
    <input type="date" id="f-closing-tanggal" value="${closingTanggal}" max="${today}" ${minDate?`min="${minDate}"`:''}
      onchange="closingTanggal=this.value; document.getElementById('screen').innerHTML=screenTutupKasir();">
    ${isBackfill? `<div class="hint" style="color:var(--warning)">⚠ Ini penutupan susulan untuk tanggal lampau (lupa tutup kemarin). Saldo sistem di bawah dihitung sampai akhir <b>${closingTanggal}</b> saja — transaksi setelah tanggal ini (termasuk yang sudah Anda input hari ini) TIDAK ikut dihitung maupun ikut terkunci.</div>` : ''}
    <div class="card-sub">
      <div class="lbl">SALDO SISTEM PER AKHIR ${esc(closingTanggal)}</div>
      <div class="val">${fmtRp(saldoSistem)}</div>
    </div>
    ${relatedKasbon.length? `<div class="hint" style="color:var(--warning)">Ada ${relatedKasbon.length} kasbon belum lunas pada tanggal ini terkait akun ini — selisih terkait ini tidak otomatis dianggap kecurangan.</div>`:''}
    <label class="f">Saldo Fisik (hasil hitung nyata)</label>
    <input type="text" id="f-saldofisik" inputmode="numeric" placeholder="0" onfocus="scrollToMe(this)"
      oninput="this.value=this.value.replace(/[^0-9]/g,''); updateSelisihPreview(${saldoSistem})">
    <div id="selisih-preview" class="hint"></div>
    <label class="f">Catatan (opsional)</label>
    <textarea id="f-closing-catatan" onfocus="scrollToMe(this)"></textarea>
    <div style="height:10px"></div>
    <button class="btn btn-danger" onclick="submitClosing(${saldoSistem})">Tutup Kasir Akun Ini — ${esc(closingTanggal)}</button>
  `;
}
function updateSelisihPreview(saldoSistem){
  const fisik = Number(document.getElementById('f-saldofisik').value||0);
  const selisih = fisik - saldoSistem;
  const el = document.getElementById('selisih-preview');
  el.style.color = selisih===0 ? 'var(--success)' : 'var(--danger)';
  el.textContent = 'Selisih: ' + fmtRp(selisih) + (selisih===0? ' (sesuai)' : selisih>0 ? ' (lebih)' : ' (kurang)');
}
function submitClosing(saldoSistem){
  const tanggal = closingTanggal;
  const lastClosing = getLatestClosing(closingAccId);
  if(lastClosing && tanggal<=lastClosing.tanggal) return toast('Tanggal ini sudah pernah ditutup kasir','error');
  if(tanggal>todayStr()) return toast('Tidak bisa menutup kasir untuk tanggal yang belum terjadi','error');
  const fisik = Number(document.getElementById('f-saldofisik').value||0);
  const catatan = document.getElementById('f-closing-catatan').value.trim();
  const selisih = fisik - saldoSistem;
  if(!confirm('Tutup kasir untuk akun ini pada tanggal '+tanggal+'? Semua transaksi tanggal itu & sebelumnya pada akun ini akan terkunci permanen.')) return;
  DB.closings.push({id:uid('closings'), tanggal, account_id: closingAccId, saldo_sistem: saldoSistem,
    saldo_fisik: fisik, selisih, catatan, waktu_tutup: nowIso()});
  DB.transactions.forEach(t=>{
    if((t.account_id===closingAccId || t.target_account_id===closingAccId) && t.tanggal<=tanggal) t.locked=1;
  });
  saveDB();
  closingTanggal = null;
  toast(selisih===0? 'Kasir ditutup, saldo sesuai' : 'Kasir ditutup, ada selisih '+fmtRp(selisih), selisih===0?'ok':'error');
  navigate('dashboard');
}

/* ---------------- LAPORAN ---------------- */
function screenLaporan(){
  const today = todayStr();
  const monthPrefix = today.slice(0,7);
  const inMonth = DB.transactions.filter(t=>t.tanggal.startsWith(monthPrefix));
  let pendapatan=0, cogs=0, opex=0;
  inMonth.forEach(t=>{
    if(t.flow==='Pemasukan' && t.payment_status==='paid') pendapatan += (t.profit||0);
    if(t.flow==='Pengeluaran'){ if(t.expense_type==='COGS') cogs+=t.amount; else opex+=t.amount; }
  });
  const netProfit = pendapatan - cogs - opex;

  const perKategori = {};
  inMonth.filter(t=>t.flow==='Pemasukan').forEach(t=>{
    perKategori[t.kategori] = perKategori[t.kategori] || {amount:0, profit:0};
    perKategori[t.kategori].amount += t.amount; perKategori[t.kategori].profit += (t.profit||0);
  });
  const maxAmt = Math.max(1, ...Object.values(perKategori).map(v=>v.amount));

  return `
    <div class="section-title">Laba Rugi — ${monthPrefix}</div>
    <div class="card">
      <div class="row-item"><div class="row-main"><div class="row-title">Pendapatan Riil (profit)</div></div><div class="row-amt" style="color:var(--success)">${fmtRp(pendapatan)}</div></div>
      <div class="row-item"><div class="row-main"><div class="row-title">Harga Pokok (COGS)</div></div><div class="row-amt" style="color:var(--danger)">-${fmtRp(cogs)}</div></div>
      <div class="row-item"><div class="row-main"><div class="row-title">Beban Operasional (OPEX)</div></div><div class="row-amt" style="color:var(--danger)">-${fmtRp(opex)}</div></div>
      <div class="row-item"><div class="row-main"><div class="row-title" style="font-size:calc(15px * var(--fs-mult))">Laba Bersih</div></div><div class="row-amt" style="font-size:calc(16px * var(--fs-mult));color:${netProfit>=0?'var(--success)':'var(--danger)'}">${fmtRp(netProfit)}</div></div>
    </div>

    <div class="section-title">Margin per Kategori (bulan ini)</div>
    <div class="card">
      ${Object.keys(perKategori).length? Object.entries(perKategori).map(([k,v])=>`
        <div style="margin-bottom:10px;">
          <div style="display:flex;justify-content:space-between;font-size:calc(12.5px * var(--fs-mult));font-weight:700;">
            <span>${esc(k)}</span><span>${fmtRp(v.amount)} <span style="color:var(--muted);font-weight:500;">(profit ${fmtRp(v.profit)})</span></span>
          </div>
          <div style="background:#e2e8f0;border-radius:8px;height:8px;margin-top:4px;">
            <div style="background:var(--primary);height:8px;border-radius:8px;width:${(v.amount/maxAmt*100).toFixed(0)}%"></div>
          </div>
        </div>`).join('') : '<div class="empty-state">Belum ada data.</div>'}
    </div>
  `;
}

