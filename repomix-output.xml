    case 'tutupkasir': return screenTutupKasir();
    case 'laporan': return screenLaporan();
    case 'audit': return screenAudit();
    case 'settingAkun': return screenSettingAkun();
    case 'settingKategori': return screenSettingKategori();
    case 'settingKasir': return screenSettingKasir();
    case 'settingImportExport': return screenImportExport();
    case 'settingFont': return screenSettingFont();
    case 'txDetail': return screenTxDetail();
    default: return '<div class="empty-state">Layar tidak ditemukan</div>';
  }
}

/* ---------------- DASHBOARD ---------------- */
function screenDashboard(){
  const today = todayStr();
  let pendapatanRiil=0, volume=0;
  for(const t of DB.transactions){
    if(t.tanggal!==today) continue;
    if(t.flow==='Pemasukan' && t.payment_status==='paid') pendapatanRiil += (t.profit||0);
    if(t.flow==='Pemasukan' || t.flow==='Pengeluaran') volume += t.amount;
  }
  const alerts = [];
  for(const a of activeAccounts()){
    const s = getSaldo(a.id);
    if(s < a.ambang_minimum) alerts.push({txt:`${a.name} di bawah ambang (${fmtRp(s)})`, danger:true});
  }
  const kasbonJatuhTempo = DB.kasbon.filter(k=>k.status==='unpaid' &&
    (Date.now() - new Date(k.tanggal).getTime()) > 7*86400000);
  if(kasbonJatuhTempo.length) alerts.push({txt:`${kasbonJatuhTempo.length} kasbon jatuh tempo (>7 hari)`, danger:true});
  const lastAudit = DB.transactions.filter(t=>t.flag_suspect).length;
  if(lastAudit) alerts.push({txt:`${lastAudit} transaksi ditandai audit`, danger:false});

  const byTipe = {};
  for(const a of activeAccounts()){ (byTipe[a.tipe]=byTipe[a.tipe]||[]).push(a); }

  return `
    <div class="card-hero">
      <div class="lbl">PENDAPATAN RIIL HARI INI</div>
      <div class="val">${fmtRp(pendapatanRiil)}</div>
    </div>
    <div class="card-sub">
      <div class="lbl">VOLUME TRANSAKSI HARI INI &nbsp;<span title="Dana yang lewat, bukan pendapatan Anda">ⓘ</span></div>
      <div class="val" style="color:var(--muted)">${fmtRp(volume)}</div>
      <div class="hint">Dana lewat (masuk+keluar), bukan pendapatan bersih Anda.</div>
    </div>
    ${alerts.length? `<div class="alert-strip">${alerts.map(a=>`<div class="alert-chip ${a.danger?'danger':''}">${esc(a.txt)}</div>`).join('')}</div>`:''}

    <div class="section-title">Pintasan</div>
    <div class="shortcuts">
      <button class="shortcut" style="background:#0F766E" onclick="navigate('tutupkasir')"><span class="ic">🔐</span>Tutup Kasir</button>
      <button class="shortcut" style="background:var(--mutasi)" onclick="navigate('transfer')"><span class="ic">🔁</span>Pindah Saldo</button>
      <button class="shortcut" style="background:var(--bank)" onclick="navigate('laporan')"><span class="ic">📊</span>Laporan</button>
      <button class="shortcut" style="background:var(--voucher)" onclick="navigate('laporan')"><span class="ic">🏷️</span>Per Kategori</button>
      <button class="shortcut" style="background:var(--warning)" onclick="navigate('kasbon')"><span class="ic">🧾</span>Kasbon</button>
    </div>

    <div class="section-title">Saldo Akun</div>
    ${Object.keys(byTipe).map(tipe=>`
      <div style="font-size:calc(11.5px * var(--fs-mult));font-weight:700;color:var(--muted);margin:8px 0 4px 2px;">${ACC_LABEL[tipe]}</div>
      ${byTipe[tipe].map(a=>{
        const s = getSaldo(a.id); const low = s < a.ambang_minimum;
        return `<div class="acc-card ${low?'low':''}" style="background:${ACC_COLOR[tipe]}">
          <div class="name">${esc(a.name)}</div>
          <div class="tipe">${ACC_LABEL[tipe]}</div>
          <div class="saldo">${fmtRp(s)}</div>
        </div>`;
      }).join('')}
    `).join('') || `<div class="empty-state"><div class="ic">🏦</div>Belum ada akun aktif.<br>Tambahkan lewat Setting → Kelola Akun.</div>`}
  `;
}

